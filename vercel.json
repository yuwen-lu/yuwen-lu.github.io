{
  "redirects": [
    {
      "source": "/cv",
      "destination": "/resume",
      "permanent": true
    },
    {
      "source": "/crepe",
      "destination": "https://crepe-website.vercel.app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/calligraphy",
      "destination": "/calligraphy/index.html"
    },
    {
      "source": "/calligraphy/how-it-works",
      "destination": "/calligraphy/how-it-works.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
